---
import { perfil } from '../data/perfil';
import Icone from './Icone.astro';

const principal = perfil.email
  ? { texto: perfil.email, href: `mailto:${perfil.email}`, externo: false }
  : { texto: 'github.com/mathshow10', href: perfil.links[0]?.url ?? '#', externo: true };
---

<section id="contato" class="section">
  <div class="container">
    <h2 class="display reveal">Vamos conversar?</h2>
    <p class="reveal">
      {perfil.email
        ? 'O e-mail é o jeito mais rápido de falar comigo, seja sobre uma vaga, um projeto ou algo que você viu aqui.'
        : 'Estou aberto a vagas, estágios e projetos. Me encontre por aqui:'}
    </p>
    <a class="principal reveal" href={principal.href} {...(principal.externo ? { target: '_blank', rel: 'noopener' } : {})}>
      {principal.texto}
      <Icone nome="seta" />
    </a>
    <ul class="outros reveal">
      {perfil.links.map((l) => <li><a href={l.url} target="_blank" rel="noopener">{l.nome}</a></li>)}
    </ul>
  </div>
</section>

<style>
  .section > .container {
    padding-block: 120px;
  }
  h2 {
    font-size: clamp(2.75rem, 2rem + 3vw, 4.25rem);
  }
  p {
    max-width: 52ch;
    margin-top: 20px;
    color: var(--muted);
    font-size: 1.0625rem;
  }
  .principal {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 36px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--accent);
    font-size: clamp(1.375rem, 1.1rem + 1.2vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .principal :global(svg) {
    width: 22px;
    height: 22px;
    color: var(--accent);
    flex-shrink: 0;
    transition: transform 0.3s var(--ease);
  }
  .principal:hover :global(svg) {
    transform: translate(3px, -3px);
  }
  .outros {
    display: flex;
    gap: 24px;
    margin-top: 28px;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .outros a:hover {
    color: var(--ink);
  }
  @media (max-width: 560px) {
    .section > .container {
      padding-block: 80px;
    }
  }
</style>
