<button class="toggle" type="button" data-theme-toggle aria-label="Alternar tema claro/escuro">
  <svg class="sol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="lua" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"></path>
  </svg>
</button>

<style>
  .toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .toggle:hover {
    color: var(--fg);
    border-color: var(--line-strong);
  }
  svg {
    position: absolute;
    width: 17px;
    height: 17px;
    transition: transform 0.5s var(--ease), opacity 0.3s;
  }
  /* Claro: mostra a lua (ação = ir para escuro) */
  .sol {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
  :global([data-resolved-theme='dark']) .sol {
    opacity: 1;
    transform: none;
  }
  :global([data-resolved-theme='dark']) .lua {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }
</style>

<script>
  const root = document.documentElement;
  const mq = window.matchMedia('(prefers-color-scheme: dark)');
  const atual = () => (root.dataset.theme as 'light' | 'dark' | undefined) ?? (mq.matches ? 'dark' : 'light');
  const sync = () => (root.dataset.resolvedTheme = atual());
  sync();
  mq.addEventListener('change', sync);

  document.querySelectorAll('[data-theme-toggle]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const novo = atual() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = novo;
      try {
        localStorage.setItem('tema', novo);
      } catch {}
      sync();
    }),
  );
</script>
