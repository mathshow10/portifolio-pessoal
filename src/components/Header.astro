---
import { perfil } from '../data/perfil';
import { url } from '../scripts/url';
import ThemeToggle from './ThemeToggle.astro';

const itens = [
  { id: 'projetos', nome: 'Projetos' },
  { id: 'experiencia', nome: 'Experiência' },
  { id: 'habilidades', nome: 'Habilidades' },
  { id: 'contato', nome: 'Contato' },
];
---

<header class="header">
  <div class="container bar">
    <a href={url('/')} class="marca">
      <span class="logo" aria-hidden="true">M</span>
      <span>{perfil.nome}</span>
    </a>
    <nav aria-label="Principal">
      <ul>
        {itens.map((i) => <li><a href={url(`/#${i.id}`)} data-nav={i.id}>{i.nome}</a></li>)}
      </ul>
    </nav>
    <div class="acoes">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(160%) blur(12px);
    -webkit-backdrop-filter: saturate(160%) blur(12px);
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header-h);
  }
  .marca {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
  }
  .logo {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 7px;
    background: var(--accent);
    color: var(--surface);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1;
  }
  nav ul {
    display: flex;
    gap: 28px;
  }
  nav a {
    color: var(--muted);
    font-size: 0.9375rem;
    transition: color 0.2s;
  }
  nav a:hover,
  nav a.ativo {
    color: var(--ink);
  }
  .acoes {
    display: flex;
    justify-content: flex-end;
  }
  @media (max-width: 760px) {
    .bar {
      grid-template-columns: 1fr auto;
    }
    nav {
      display: none;
    }
  }
</style>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
  const secoes = [...links]
    .map((a) => document.getElementById(a.dataset.nav!))
    .filter((s): s is HTMLElement => !!s);
  if (secoes.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) links.forEach((a) => a.classList.toggle('ativo', a.dataset.nav === e.target.id));
        }
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );
    secoes.forEach((s) => io.observe(s));
  }
</script>
