---
import type { CollectionEntry } from 'astro:content';
import { url } from '../scripts/url';
import { origem } from '../scripts/origem';
import IconeOrigem from './IconeOrigem.astro';

interface Props {
  projeto: CollectionEntry<'projetos'>;
}
const { projeto } = Astro.props;
const { titulo, resumo, tags, stack, destaque, status, data, repositorio } = projeto.data;
const fonte = origem(repositorio);
const ano = data.getUTCFullYear();
---

<article class:list={['card', { destaque }]} data-spotlight data-tags={tags.join('|')}>
  <a href={url(`/projetos/${projeto.id}/`)} class="cobre" aria-label={`Ver projeto ${titulo}`}></a>
  <div class="topo mono">
    <span>{ano}</span>
    {status === 'em-andamento' && <span class="andamento">Em andamento</span>}
    {destaque && <span class="selo">Destaque</span>}
    {fonte && <span class="fonte" title={`Código no ${fonte}`}><IconeOrigem origem={fonte} />{fonte}</span>}
  </div>
  <h3>
    {titulo}
    <svg class="seta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
  </h3>
  <p>{resumo}</p>
  <ul class="stack">
    {stack.slice(0, 4).map((s) => <li class="tag">{s}</li>)}
  </ul>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    overflow: hidden;
    transition: border-color 0.3s, transform 0.4s var(--ease);
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(380px circle at var(--mx, 50%) var(--my, 0%), var(--glow), transparent 60%);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .card:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }
  .card:hover::before {
    opacity: 1;
  }
  .card:focus-within {
    border-color: var(--accent);
  }
  .cobre {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius);
  }
  .topo {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--fg-subtle);
    font-size: 0.75rem;
  }
  .andamento::before {
    content: '·';
    margin-right: 10px;
  }
  .selo {
    color: var(--accent);
  }
  .selo::before {
    content: '·';
    margin-right: 10px;
    color: var(--fg-subtle);
  }
  .fonte {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }
  h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.25rem;
  }
  .seta {
    width: 18px;
    height: 18px;
    color: var(--fg-subtle);
    transition: transform 0.35s var(--ease), color 0.2s;
  }
  .card:hover .seta {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
  p {
    color: var(--fg-muted);
    font-size: 0.9375rem;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 8px;
  }
  .card[hidden] {
    display: none;
  }
  @media (max-width: 560px) {
    .card {
      padding: 22px;
    }
  }
</style>
