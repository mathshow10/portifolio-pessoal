---
import { perfil } from '../data/perfil';
import { url } from '../scripts/url';
const github = perfil.links.find((l) => l.nome === 'GitHub');
const palavras = ['código', 'automação', 'IA'];
---

<section class="hero" data-hero>
  <div class="grade" aria-hidden="true"></div>
  <div class="container conteudo">
    <p class="status reveal mono">
      <span class="ponto" aria-hidden="true"></span>
      {perfil.status} · {perfil.local}
    </p>

    <h1 class="reveal" style="--delay: 80ms">
      {perfil.nome}
      <span class="sub">
        Resolvo problemas reais com
        <span class="rotativo" data-words={JSON.stringify(palavras)} aria-label={palavras.join(', ')}>
          <span data-word aria-hidden="true">{palavras[0]}</span>
        </span>
      </span>
    </h1>

    <p class="resumo reveal" style="--delay: 160ms">{perfil.resumo}</p>

    <div class="acoes reveal" style="--delay: 240ms">
      <a class="btn primary" href={url('/#projetos')}>
        Ver projetos
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M19 12l-7 7-7-7"></path></svg>
      </a>
      {
        github && (
          <a class="btn" href={github.url} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path></svg>
            GitHub
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 120px 0 112px;
    margin-top: -68px;
    padding-top: calc(120px + 68px);
  }
  .grade {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--line-strong) 1px, transparent 1px);
    background-size: 26px 26px;
    -webkit-mask-image: radial-gradient(520px circle at var(--hx, 70%) var(--hy, 30%), #000 0%, transparent 70%);
    mask-image: radial-gradient(520px circle at var(--hx, 70%) var(--hy, 30%), #000 0%, transparent 70%);
    pointer-events: none;
  }
  .grade::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(360px circle at var(--hx, 70%) var(--hy, 30%), var(--glow), transparent 70%);
  }
  .conteudo {
    position: relative;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 12px;
    margin-bottom: 32px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-elev);
    color: var(--fg-muted);
    font-size: 0.75rem;
  }
  .ponto {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .ponto::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    animation: pulso 2.4s var(--ease) infinite;
  }
  @keyframes pulso {
    0% { transform: scale(1); opacity: 0.6; }
    70%, 100% { transform: scale(3); opacity: 0; }
  }
  h1 {
    font-size: clamp(2.5rem, 1.6rem + 4.2vw, 4.75rem);
    letter-spacing: -0.045em;
    line-height: 1.02;
    max-width: 14ch;
  }
  .sub {
    display: block;
    margin-top: 14px;
    font-size: clamp(1.25rem, 1rem + 1.4vw, 2rem);
    letter-spacing: -0.03em;
    font-weight: 500;
    color: var(--fg-muted);
    max-width: none;
  }
  .rotativo {
    display: inline-block;
    color: var(--accent);
  }
  [data-word] {
    display: inline-block;
    transition: opacity 0.35s var(--ease), transform 0.35s var(--ease), filter 0.35s;
  }
  [data-word].saindo {
    opacity: 0;
    transform: translateY(-0.3em);
    filter: blur(4px);
  }
  [data-word].entrando {
    opacity: 0;
    transform: translateY(0.3em);
    filter: blur(4px);
    transition: none;
  }
  .resumo {
    max-width: 58ch;
    margin-top: 28px;
    color: var(--fg-muted);
    font-size: 1.0625rem;
  }
  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }
  @media (max-width: 560px) {
    .hero {
      padding-bottom: 80px;
      padding-top: calc(72px + 68px);
    }
    .status {
      margin-bottom: 24px;
    }
  }
</style>

<script>
  // Grade de pontos que segue o cursor
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const reduz = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (hero && !reduz) {
    let raf = 0;
    hero.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const r = hero.getBoundingClientRect();
        hero.style.setProperty('--hx', `${e.clientX - r.left}px`);
        hero.style.setProperty('--hy', `${e.clientY - r.top}px`);
      });
    });
  }

  // Palavra que alterna no título
  const alvo = document.querySelector<HTMLElement>('[data-words]');
  const palavra = alvo?.querySelector<HTMLElement>('[data-word]');
  if (alvo && palavra && !reduz) {
    const lista: string[] = JSON.parse(alvo.dataset.words || '[]');
    let i = 0;
    setInterval(() => {
      if (document.hidden) return;
      i = (i + 1) % lista.length;
      palavra.classList.add('saindo');
      setTimeout(() => {
        palavra.textContent = lista[i];
        palavra.classList.remove('saindo');
        palavra.classList.add('entrando');
        void palavra.offsetWidth;
        palavra.classList.remove('entrando');
      }, 350);
    }, 2600);
  }
</script>
