---
import { perfil, habilidades } from '../data/perfil';
---

<section id="sobre" class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="index mono">01</span>
      <h2>Sobre mim</h2>
    </div>

    <div class="grid">
      <div class="texto">
        {perfil.sobre.map((p, i) => <p class="reveal" style={`--delay: ${i * 60}ms`}>{p}</p>)}
      </div>

      <aside class="lado reveal" style="--delay: 120ms">
        <dl>
          <div>
            <dt class="mono">Base</dt>
            <dd>{perfil.local}</dd>
          </div>
          <div>
            <dt class="mono">Foco</dt>
            <dd>{perfil.cargo} · {perfil.foco}</dd>
          </div>
          <div>
            <dt class="mono">Idiomas</dt>
            <dd>
              <ul class="idiomas">
                {perfil.idiomas.map((i) => <li><span>{i.nome}</span><span class="nivel">{i.nivel}</span></li>)}
              </ul>
            </dd>
          </div>
        </dl>
      </aside>
    </div>

    <div class="habilidades">
      {
        habilidades.map((g, i) => (
          <div class="grupo reveal" style={`--delay: ${i * 70}ms`}>
            <h3 class="mono">{g.grupo}</h3>
            <ul>
              {g.itens.map((s) => <li class="tag">{s}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 64px;
  }
  .texto {
    display: grid;
    gap: 20px;
    font-size: 1.0625rem;
    color: var(--fg-muted);
  }
  .texto p:first-child {
    color: var(--fg);
  }
  dl {
    margin: 0;
    display: grid;
    gap: 24px;
  }
  dt {
    margin-bottom: 6px;
    color: var(--fg-subtle);
    text-transform: uppercase;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
  }
  dd {
    margin: 0;
  }
  .idiomas {
    display: grid;
    gap: 6px;
  }
  .idiomas li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 6px;
    border-bottom: 1px dashed var(--line);
  }
  .nivel {
    color: var(--fg-subtle);
    font-size: 0.875rem;
  }
  .habilidades {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin-top: 72px;
    padding-top: 40px;
    border-top: 1px dashed var(--line);
  }
  .grupo h3 {
    margin-bottom: 14px;
    color: var(--fg-subtle);
    font-weight: 500;
    text-transform: uppercase;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
  }
  .grupo ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .grupo .tag {
    transition: border-color 0.2s, color 0.2s;
  }
  .grupo .tag:hover {
    border-color: var(--accent);
    color: var(--fg);
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .habilidades {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-top: 48px;
    }
  }
</style>
