---
import { perfil } from '../data/perfil';
import { url } from '../scripts/url';
const ano = new Date().getFullYear();
const curriculo = import.meta.env.DEV ? url('/cv') : url('/curriculo-matheus-lencione.pdf');
---

<footer class="footer">
  <div class="container linha">
    <p>© {ano} {perfil.nome} · Feito com Astro e publicado no GitHub Pages.</p>
    <nav aria-label="Rodapé">
      <ul>
        <li><a href={curriculo} target="_blank" rel="noopener">Currículo em PDF</a></li>
        <li><a href="#" class="topo">Voltar ao topo <span aria-hidden="true">↑</span></a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: 32px;
    color: var(--subtle);
    font-size: 0.875rem;
  }
  .linha {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 24px;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
  }
  a {
    color: var(--muted);
    transition: color 0.2s;
  }
  a:hover {
    color: var(--ink);
  }
  .topo span {
    display: inline-block;
    transition: transform 0.3s var(--ease);
  }
  .topo:hover span {
    transform: translateY(-2px);
  }
</style>
