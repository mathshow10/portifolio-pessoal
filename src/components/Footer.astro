---
import { perfil } from '../data/perfil';
const ano = new Date().getFullYear();
---

<footer class="footer">
  <div class="container linha">
    <p>© {ano} {perfil.nome}</p>
    <p class="mono">Feito com Astro · <a class="link" href="https://github.com/mathshow10/portifolio-pessoal" target="_blank" rel="noopener">código-fonte</a></p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding: 32px 0 40px;
    color: var(--fg-subtle);
    font-size: 0.875rem;
  }
  .linha {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
  }
  .footer a {
    color: var(--fg-muted);
  }
</style>
