---
import { habilidades } from '../data/perfil';
---

<section id="habilidades" class="section">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">Habilidades</p>
      <h2 class="display">Com o que eu trabalho</h2>
      <p>Organizado por área.</p>
    </header>

    <dl class="tabela">
      {
        habilidades.map((h) => (
          <div class="linha reveal">
            <dt>{h.area}</dt>
            <dd>
              <ul>
                {h.itens.map((i) => <li class="chip">{i}</li>)}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .linha {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 12px 32px;
    align-items: center;
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
  }
  .linha:last-child {
    border-bottom: 0;
  }
  dt {
    font-weight: 500;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  @media (max-width: 680px) {
    .linha {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
