---
import { getCollection } from 'astro:content';
import Icone from './Icone.astro';
import { url } from '../scripts/url';

const todos = await getCollection('projetos');
const ordenar = (a: (typeof todos)[number], b: (typeof todos)[number]) => a.data.ordem - b.data.ordem;
const principais = todos.filter((p) => p.data.categoria === 'principal').sort(ordenar);
const outros = todos.filter((p) => p.data.categoria === 'outro').sort(ordenar);
const origem = (u?: string) => (!u ? '' : u.includes('gitlab.com') ? 'GitLab' : u.includes('github.com') ? 'GitHub' : 'Código');
---

<section id="projetos" class="section">
  <div class="container">
    <header class="section-head reveal">
      <h2 class="display">Projetos</h2>
    </header>

    <div class="principais">
      {
        principais.map((p) => {
          const d = p.data;
          const topicos = d.destaques.length > 0 && (
            <ul class="topicos">
              {d.destaques.map((t) => <li>{t}</li>)}
            </ul>
          );
          return (
            <article class="card reveal" id={`projeto-${p.id}`}>
              <div class="info">
                {d.contexto && <p class="meta mono">{d.contexto}</p>}
                <h3>{d.titulo}</h3>
                <p class="frase">{d.frase}</p>
                <div class="rodape">
                  <ul class="chips">
                    {d.stack.map((s) => <li class="chip">{s}</li>)}
                  </ul>
                  {d.repositorio && (
                    <a class="repo mono" href={d.repositorio} target="_blank" rel="noopener">
                      Ver no {origem(d.repositorio)} <Icone nome="seta" />
                    </a>
                  )}
                </div>
              </div>
              <div class="lado">{topicos}</div>
              {d.imagens.length > 0 && (
                <div class="telas">
                  {d.imagens.map((img) => (
                    <figure>
                      <a href={url(`/${img.src}`)} target="_blank" rel="noopener">
                        <img src={url(`/${img.src}`)} alt={img.legenda} width={img.largura} height={img.altura} loading="lazy" decoding="async" />
                      </a>
                      <figcaption>{img.legenda}</figcaption>
                    </figure>
                  ))}
                </div>
              )}
            </article>
          );
        })
      }
    </div>

    {
      outros.length > 0 && (
        <div class="outros">
          <header class="sub reveal">
            <h3 class="display">Outros projetos</h3>
          </header>
          <div class="grade">
            {outros.map((p) => (
              <a class="mini reveal" id={`projeto-${p.id}`} href={p.data.repositorio ?? p.data.demo ?? '#'} target="_blank" rel="noopener">
                <div class="mini-topo">
                  <h4>{p.data.titulo}</h4>
                  <Icone nome="seta" />
                </div>
                {p.data.contexto && <p class="mono ctx">{p.data.contexto}</p>}
                <p class="desc">{p.data.frase}</p>
                <p class="mono stack">{p.data.stack.join(' · ')}</p>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .principais {
    display: grid;
    gap: 16px;
  }
  .card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
    padding: 36px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .card:target {
    border-color: var(--accent);
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .meta {
    color: var(--subtle);
    font-size: 0.75rem;
  }
  h3 {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .frase {
    color: var(--ink);
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .lado > .topicos {
    padding-top: 4px;
  }
  .telas {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: 16px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  figure {
    margin: 0;
  }
  figure a {
    display: block;
    padding: 10px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--bg) 70%, var(--line));
  }
  figure img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.12), 0 6px 18px rgb(0 0 0 / 0.1);
  }
  figcaption {
    margin-top: 8px;
    color: var(--subtle);
    font-size: 0.8125rem;
    line-height: 1.45;
  }
  .topicos {
    display: grid;
    gap: 10px;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .topicos li {
    position: relative;
    padding-left: 16px;
  }
  .topicos li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.7em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--subtle);
  }
  .rodape {
    display: grid;
    gap: 16px;
    margin-top: auto;
    padding-top: 8px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .repo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    color: var(--accent);
    font-size: 0.8125rem;
  }
  .repo:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .repo :global(svg),
  .mini-topo :global(svg) {
    width: 14px;
    height: 14px;
  }

  .outros {
    margin-top: 72px;
  }
  .sub {
    display: grid;
    gap: 8px;
    margin-bottom: 28px;
  }
  .sub h3 {
    font-size: clamp(1.75rem, 1.5rem + 1vw, 2.25rem);
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .grade {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .mini {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 14px;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .mini:hover {
    border-color: var(--line-strong);
    background: var(--surface);
  }
  .mini-topo {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .mini-topo :global(svg) {
    color: var(--subtle);
    flex-shrink: 0;
    transition: color 0.2s, transform 0.3s var(--ease);
  }
  .mini:hover .mini-topo :global(svg) {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
  h4 {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .ctx {
    color: var(--accent);
    font-size: 0.75rem;
  }
  .desc {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .stack {
    margin-top: auto;
    padding-top: 6px;
    color: var(--subtle);
    font-size: 0.75rem;
  }
  @media (max-width: 860px) {
    /* No celular: texto, tópicos, imagens e, por último, tecnologias e link. */
    .card {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .info {
      display: contents;
    }
    .lado {
      order: 1;
    }
    .telas {
      order: 2;
      grid-template-columns: 1fr;
      padding-top: 20px;
    }
    .rodape {
      order: 3;
    }
    .grade {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .card {
      padding: 24px 20px;
    }
    .outros {
      margin-top: 64px;
    }
  }
</style>
