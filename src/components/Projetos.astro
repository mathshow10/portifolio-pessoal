---
import { getCollection } from 'astro:content';
import Icone from './Icone.astro';

const todos = await getCollection('projetos');
const ordenar = (a: (typeof todos)[number], b: (typeof todos)[number]) => a.data.ordem - b.data.ordem;
const principais = todos.filter((p) => p.data.categoria === 'principal').sort(ordenar);
const outros = todos.filter((p) => p.data.categoria === 'outro').sort(ordenar);
const origem = (u?: string) => (!u ? '' : u.includes('gitlab.com') ? 'GitLab' : u.includes('github.com') ? 'GitHub' : 'Código');
---

<section id="projetos" class="section">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">Projetos</p>
      <h2 class="display">O que eu construí</h2>
      <p>Os projetos de que mais me orgulho e o que cada um resolve.</p>
    </header>

    <div class="principais">
      {
        principais.map((p, i) => (
          <article class="card reveal" id={`projeto-${p.id}`}>
            <div class="meta mono">
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              {p.data.contexto && <span>{p.data.contexto}</span>}
            </div>
            <h3>{p.data.titulo}</h3>
            <blockquote>{p.data.frase}</blockquote>
            {p.data.destaques.length > 0 && (
              <ul class="topicos">
                {p.data.destaques.map((d) => <li>{d}</li>)}
              </ul>
            )}
            <div class="rodape">
              <ul class="chips">
                {p.data.stack.map((s) => <li class="chip">{s}</li>)}
              </ul>
              {p.data.repositorio && (
                <a class="repo mono" href={p.data.repositorio} target="_blank" rel="noopener">
                  Ver no {origem(p.data.repositorio)} <Icone nome="seta" />
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>

    {
      outros.length > 0 && (
        <div class="outros">
          <header class="sub reveal">
            <p class="eyebrow">Estudos e laboratórios</p>
            <h3 class="display">Outros projetos</h3>
          </header>
          <div class="grade">
            {outros.map((p) => (
              <a class="mini reveal" id={`projeto-${p.id}`} href={p.data.repositorio ?? p.data.demo ?? '#'} target="_blank" rel="noopener">
                <div class="mini-topo">
                  <h4>{p.data.titulo}</h4>
                  <Icone nome="seta" />
                </div>
                {p.data.contexto && <p class="mono ctx">{p.data.contexto}</p>}
                <p class="desc">{p.data.frase}</p>
                <p class="mono stack">{p.data.stack.join(' · ')}</p>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .principais {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .card:target {
    border-color: var(--accent);
  }
  .meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--subtle);
    font-size: 0.75rem;
  }
  .num {
    color: var(--accent);
  }
  h3 {
    font-size: 1.3125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  blockquote {
    padding-left: 16px;
    border-left: 2px solid var(--accent);
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.4;
    letter-spacing: -0.005em;
  }
  .topicos {
    display: grid;
    gap: 10px;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .topicos li {
    position: relative;
    padding-left: 16px;
  }
  .topicos li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.7em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--subtle);
  }
  .rodape {
    display: grid;
    gap: 16px;
    margin-top: auto;
    padding-top: 8px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .repo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    color: var(--accent);
    font-size: 0.8125rem;
  }
  .repo:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .repo :global(svg),
  .mini-topo :global(svg) {
    width: 14px;
    height: 14px;
  }

  .outros {
    margin-top: 88px;
  }
  .sub {
    display: grid;
    gap: 8px;
    margin-bottom: 28px;
  }
  .sub h3 {
    font-size: clamp(1.75rem, 1.5rem + 1vw, 2.25rem);
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .grade {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .mini {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 14px;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .mini:hover {
    border-color: var(--line-strong);
    background: var(--surface);
  }
  .mini-topo {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .mini-topo :global(svg) {
    color: var(--subtle);
    flex-shrink: 0;
    transition: color 0.2s, transform 0.3s var(--ease);
  }
  .mini:hover .mini-topo :global(svg) {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
  h4 {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .ctx {
    color: var(--accent);
    font-size: 0.75rem;
  }
  .desc {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .stack {
    margin-top: auto;
    padding-top: 6px;
    color: var(--subtle);
    font-size: 0.75rem;
  }
  @media (max-width: 860px) {
    .principais,
    .grade {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .card {
      padding: 24px 20px;
    }
    .meta {
      flex-direction: column;
      gap: 4px;
    }
    .outros {
      margin-top: 64px;
    }
  }
</style>
