---
import { getCollection } from 'astro:content';
import ProjetoCard from './ProjetoCard.astro';
import EstudoItem from './EstudoItem.astro';

const todos = (await getCollection('projetos')).sort(
  (a, b) =>
    Number(b.data.destaque) - Number(a.data.destaque) ||
    b.data.data.getTime() - a.data.data.getTime(),
);
const projetos = todos.filter((p) => p.data.categoria === 'projeto');
const estudos = todos.filter((p) => p.data.categoria === 'estudo');
const tags = [...new Set(todos.flatMap((p) => p.data.tags))].sort((a, b) => a.localeCompare(b, 'pt-BR'));
---

<section id="projetos" class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="index mono">03</span>
      <h2>Projetos</h2>
      <span class="contagem mono" data-contagem>{todos.length}</span>
    </div>

    {
      tags.length > 1 && (
        <div class="filtros reveal" role="group" aria-label="Filtrar projetos por área">
          <button type="button" class="filtro" aria-pressed="true" data-filtro="">
            Todos
          </button>
          {tags.map((t) => (
            <button type="button" class="filtro" aria-pressed="false" data-filtro={t}>
              {t}
            </button>
          ))}
        </div>
      )
    }

    <div class="lista" data-grupo>
      {
        projetos.map((p, i) => (
          <div class="reveal" style={`--delay: ${(i % 2) * 80}ms`} data-item>
            <ProjetoCard projeto={p} />
          </div>
        ))
      }
    </div>

    {
      estudos.length > 0 && (
        <div class="estudos" data-grupo>
          <div class="estudos-head reveal">
            <h3>Estudos e faculdade</h3>
            <p>Trabalhos menores, feitos para aprender: disciplinas da FEPI e projetos de extensão.</p>
          </div>
          <ul class="reveal">
            {estudos.map((p) => (
              <EstudoItem projeto={p} />
            ))}
          </ul>
        </div>
      )
    }

    <p class="vazio" data-vazio hidden>Nenhum projeto nessa área ainda.</p>
  </div>
</section>

<style>
  .contagem {
    margin-left: auto;
    color: var(--fg-subtle);
  }
  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: -16px 0 32px;
  }
  .filtro {
    height: 32px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--fg-muted);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background-color 0.2s;
  }
  .filtro:hover {
    color: var(--fg);
    border-color: var(--line-strong);
  }
  .filtro[aria-pressed='true'] {
    color: var(--bg);
    background: var(--fg);
    border-color: var(--fg);
  }
  .lista {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .lista > div {
    display: grid;
  }
  [data-grupo][hidden],
  .lista > div[hidden] {
    display: none;
  }
  .estudos {
    margin-top: 64px;
  }
  .estudos-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }
  .estudos-head h3 {
    font-size: 1.125rem;
    letter-spacing: -0.02em;
  }
  .estudos-head p {
    color: var(--fg-subtle);
    font-size: 0.875rem;
  }
  .vazio {
    padding: 32px 0;
    color: var(--fg-subtle);
  }
  @media (max-width: 760px) {
    .lista {
      grid-template-columns: 1fr;
    }
    .estudos {
      margin-top: 48px;
    }
  }
</style>

<script>
  const botoes = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');
  const grupos = document.querySelectorAll<HTMLElement>('[data-grupo]');
  const contagem = document.querySelector<HTMLElement>('[data-contagem]');
  const vazio = document.querySelector<HTMLElement>('[data-vazio]');

  botoes.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filtro || '';
      botoes.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let total = 0;
      grupos.forEach((g) => {
        let n = 0;
        g.querySelectorAll<HTMLElement>('[data-item], li[data-tags]').forEach((it) => {
          const el = it.matches('[data-tags]') ? it : it.querySelector<HTMLElement>('[data-tags]');
          const tags = el?.dataset.tags?.split('|') ?? [];
          const mostra = !f || tags.includes(f);
          it.hidden = !mostra;
          if (mostra) n++;
        });
        g.hidden = n === 0;
        g.querySelectorAll('.reveal').forEach((r) => r.classList.add('visible'));
        total += n;
      });
      if (contagem) contagem.textContent = String(total);
      if (vazio) vazio.hidden = total > 0;
    }),
  );
</script>
