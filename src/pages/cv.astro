---
/**
 * Currículo em formato A4. Usa os mesmos dados do site.
 * Na publicação, scripts/gerar-pdf.mjs transforma esta página em /curriculo-matheus-lencione.pdf.
 */
import '@fontsource-variable/geist';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import { getCollection } from 'astro:content';
import { perfil, experiencias, habilidades, formacao, destaques, idiomas } from '../data/perfil';
import { url } from '../scripts/url';

const site = new URL(import.meta.env.BASE_URL.replace(/\/?$/, '/'), Astro.site);
const siteTexto = site.href.replace(/^https?:\/\//, '').replace(/\/$/, '');
const semProtocolo = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const projetos = (await getCollection('projetos')).sort((a, b) =>
  a.data.categoria === b.data.categoria ? a.data.ordem - b.data.ordem : a.data.categoria === 'principal' ? -1 : 1,
);
const principais = projetos.filter((p) => p.data.categoria === 'principal');
const outros = projetos.filter((p) => p.data.categoria !== 'principal');
const base = perfil.fatos.find((f) => f.rotulo === 'Base')?.valor.split('·')[0].trim();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Currículo · {perfil.nome}</title>
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  </head>
  <body>
    <div class="barra">
      <a href={url('/')}>← Voltar ao portfólio</a>
      <button type="button" onclick="window.print()">Salvar como PDF</button>
    </div>

    <article class="folha">
      <header>
        <div>
          <h1>{perfil.nome}</h1>
          <p class="cargo">{perfil.cargo}</p>
        </div>
        <ul class="contatos">
          {perfil.email && <li><a href={`mailto:${perfil.email}`}>{perfil.email}</a></li>}
          <li><a href={site.href}>{siteTexto}</a></li>
          {perfil.links.map((l) => <li><a href={l.url}>{semProtocolo(l.url)}</a></li>)}
          {base && <li>{base}</li>}
        </ul>
      </header>

      <section>
        <h2>Resumo</h2>
        <p>{perfil.apresentacao}</p>
      </section>

      <section>
        <h2>Experiência</h2>
        {experiencias.map((e) => (
          <div class="item">
            <div class="linha">
              <h3>{e.cargo} <span>· {e.lugar}</span></h3>
              <p class="quando">{e.periodo}{e.detalhe && ` · ${e.detalhe}`}</p>
            </div>
            <p>{e.descricao}</p>
          </div>
        ))}
      </section>

      <section>
        <h2>Projetos</h2>
        {principais.map(({ data: d }) => (
          <div class="item">
            <div class="linha">
              <h3>{d.titulo}{d.contexto && <span> · {d.contexto}</span>}</h3>
              {d.repositorio && <a class="quando" href={d.repositorio}>{semProtocolo(d.repositorio)}</a>}
            </div>
            <p>{d.frase}</p>
            {d.destaques.length > 0 && <ul class="pontos">{d.destaques.map((t) => <li>{t}</li>)}</ul>}
            {d.stack.length > 0 && <p class="stack">{d.stack.join(' · ')}</p>}
          </div>
        ))}
        {outros.length > 0 && (
          <ul class="outros">
            {outros.map(({ data: d }) => (
              <li>
                <strong>{d.titulo}</strong>{d.contexto && <span class="ctx"> · {d.contexto}</span>}. {d.frase}{' '}
                {d.stack.length > 0 && <span class="stack">{d.stack.join(' · ')}</span>}
              </li>
            ))}
          </ul>
        )}
      </section>

      <div class="colunas">
        <section>
          <h2>Habilidades</h2>
          <dl class="tabela">
            {habilidades.map((h) => (
              <div><dt>{h.area}</dt><dd>{h.itens.join(', ')}</dd></div>
            ))}
          </dl>
        </section>
        <div>
          <section>
            <h2>Formação</h2>
            {formacao.map((f) => (
              <div class="item curto">
                <h3>{f.curso}</h3>
                <p class="quando">{f.lugar} · {f.periodo}</p>
              </div>
            ))}
          </section>
          <section>
            <h2>Idiomas</h2>
            <dl class="tabela">
              {idiomas.map((i) => <div><dt>{i.nome}</dt><dd>{i.nivel}</dd></div>)}
            </dl>
          </section>
          {destaques.length > 0 && (
            <section>
              <h2>Destaques</h2>
              <ul class="pontos">{destaques.map((d) => <li>{d.texto} ({d.ano})</li>)}</ul>
            </section>
          )}
        </div>
      </div>
    </article>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 14mm 15mm;
  }
  :root {
    --ink: #12141a;
    --muted: #4a505c;
    --subtle: #7a808c;
    --line: #dde0e6;
    --accent: #2446d8;
    --display: 'Newsreader Variable', Georgia, serif;
    --sans: 'Geist Variable', system-ui, -apple-system, 'Segoe UI', sans-serif;
    color-scheme: light;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: #e9ebef;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 9.6pt;
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3, p, ul, dl, dd {
    margin: 0;
  }
  ul {
    padding: 0;
    list-style: none;
  }
  a {
    color: inherit;
    text-decoration: none;
  }

  .barra {
    position: sticky;
    top: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 210mm;
    margin: 0 auto;
    padding: 14px 4px;
    font-size: 14px;
  }
  .barra a {
    color: var(--muted);
  }
  .barra button {
    height: 38px;
    padding: 0 18px;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }

  .folha {
    width: 210mm;
    min-height: 297mm;
    margin: 0 auto 40px;
    padding: 14mm 15mm;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.08), 0 12px 40px rgb(0 0 0 / 0.08);
  }

  header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 6mm;
    align-items: end;
    padding-bottom: 5mm;
    border-bottom: 1.5px solid var(--ink);
  }
  h1 {
    font-family: var(--display);
    font-size: 28pt;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .cargo {
    margin-top: 2.5mm;
    color: var(--accent);
    font-family: var(--display);
    font-style: italic;
    font-size: 12.5pt;
  }
  .contatos {
    display: grid;
    justify-items: end;
    gap: 0.6mm;
    color: var(--muted);
    font-size: 8.6pt;
  }

  section {
    margin-top: 5.5mm;
  }
  h2 {
    margin-bottom: 2.5mm;
    color: var(--accent);
    font-size: 7.6pt;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  section > p {
    color: var(--muted);
  }
  .item {
    break-inside: avoid;
  }
  .item + .item {
    margin-top: 3.5mm;
  }
  .item.curto + .item.curto {
    margin-top: 2mm;
  }
  .linha {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 4mm;
    margin-bottom: 0.8mm;
  }
  h3 {
    font-size: 10.2pt;
    font-weight: 600;
    letter-spacing: -0.005em;
  }
  h3 span {
    color: var(--muted);
    font-weight: 400;
  }
  .quando {
    flex-shrink: 0;
    color: var(--subtle);
    font-size: 8.4pt;
  }
  .item > p:not(.quando):not(.stack) {
    color: var(--muted);
  }
  .pontos {
    margin-top: 1.2mm;
    display: grid;
    gap: 0.6mm;
  }
  .pontos li {
    position: relative;
    padding-left: 3.5mm;
    color: var(--muted);
  }
  .pontos li::before {
    content: '';
    position: absolute;
    left: 0.4mm;
    top: 0.62em;
    width: 1.3mm;
    height: 1px;
    background: var(--accent);
  }
  .stack {
    margin-top: 1.2mm;
    color: var(--subtle);
    font-size: 8.4pt;
  }
  .outros {
    display: grid;
    gap: 1.6mm;
    margin-top: 3.5mm;
    padding-top: 3mm;
    border-top: 1px solid var(--line);
    color: var(--muted);
    break-inside: avoid;
  }
  .outros strong {
    color: var(--ink);
    font-weight: 600;
  }
  .outros .ctx {
    color: var(--subtle);
  }
  .outros .stack {
    display: inline;
  }

  .colunas {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 9mm;
    break-inside: avoid;
  }
  .tabela {
    display: grid;
    gap: 1.2mm;
  }
  .tabela > div {
    display: grid;
    grid-template-columns: 30mm 1fr;
    gap: 3mm;
  }
  .tabela dt {
    color: var(--ink);
    font-weight: 500;
  }
  .tabela dd {
    color: var(--muted);
  }
  .colunas > div > section:first-child,
  .colunas > section {
    margin-top: 5.5mm;
  }

  @media screen and (max-width: 820px) {
    .folha {
      width: auto;
      min-height: 0;
      margin: 0 12px 24px;
      padding: 24px 20px;
    }
    .barra {
      padding: 12px 16px;
    }
    header,
    .colunas {
      grid-template-columns: 1fr;
    }
    .contatos {
      justify-items: start;
    }
  }

  @media print {
    body {
      background: #fff;
    }
    .barra {
      display: none;
    }
    .folha {
      width: auto;
      min-height: 0;
      margin: 0;
      padding: 0;
      box-shadow: none;
    }
  }
</style>
