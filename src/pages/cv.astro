---
/**
 * Currículo em formato A4. Usa os mesmos dados do site.
 * Na publicação, scripts/gerar-pdf.mjs transforma esta página em /curriculo-matheus-lencione.pdf.
 */
import '@fontsource-variable/geist';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import { getCollection } from 'astro:content';
import { perfil, experiencias, habilidades, formacao, destaques, idiomas } from '../data/perfil';
import { url } from '../scripts/url';

const site = new URL(import.meta.env.BASE_URL.replace(/\/?$/, '/'), Astro.site);
const siteTexto = site.href.replace(/^https?:\/\//, '').replace(/\/$/, '');
const semProtocolo = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const projetos = (await getCollection('projetos')).sort((a, b) =>
  a.data.categoria === b.data.categoria ? a.data.ordem - b.data.ordem : a.data.categoria === 'principal' ? -1 : 1,
);
const principais = projetos.filter((p) => p.data.categoria === 'principal');
const outros = projetos.filter((p) => p.data.categoria !== 'principal');
const iniciais = perfil.nome.split(' ').map((n) => n[0]).slice(0, 2).join('');
const base = perfil.fatos.find((f) => f.rotulo === 'Base')?.valor.split('·')[0].trim();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Currículo · {perfil.nome}</title>
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  </head>
  <body>
    <div class="barra">
      <a href={url('/')}>← Voltar ao portfólio</a>
      <button type="button" onclick="window.print()">Salvar como PDF</button>
    </div>

    <article class="folha">
      <aside class="lateral">
        <div class="foto">
          {perfil.foto ? <img src={url(`/${perfil.foto}`)} alt="" /> : <span>{iniciais}</span>}
        </div>

        <section>
          <h2>Contato</h2>
          <ul class="contatos">
            {perfil.email && <li><a href={`mailto:${perfil.email}`}>{perfil.email}</a></li>}
            <li><a href={site.href}>{siteTexto}</a></li>
            {perfil.links.map((l) => <li><a href={l.url}>{semProtocolo(l.url)}</a></li>)}
            {base && <li>{base}</li>}
          </ul>
        </section>

        <section>
          <h2>Habilidades</h2>
          {habilidades.map((h) => (
            <div class="grupo">
              <h3>{h.area}</h3>
              <ul class="chips">{h.itens.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </section>

        <section>
          <h2>Formação</h2>
          {formacao.map((f) => (
            <div class="grupo">
              <h3>{f.curso}</h3>
              <p>{f.lugar} · {f.periodo}</p>
            </div>
          ))}
        </section>

        <section>
          <h2>Idiomas</h2>
          <dl class="idiomas">
            {idiomas.map((i) => <div><dt>{i.nome}</dt><dd>{i.nivel}</dd></div>)}
          </dl>
        </section>
      </aside>

      <div class="principal">
        <header>
          <h1>{perfil.nome}</h1>
          <p class="cargo">{perfil.cargo}</p>
        </header>

        <section>
          <h2>Resumo</h2>
          <p class="resumo">{perfil.apresentacao}</p>
        </section>

        <section>
          <h2>Experiência</h2>
          <div class="linha-do-tempo">
            {experiencias.map((e) => (
              <div class="item">
                <div class="linha">
                  <h3>{e.cargo}</h3>
                  <p class="quando">{e.periodo}</p>
                </div>
                <p class="lugar">{e.lugar}{e.detalhe && <span> · {e.detalhe}</span>}</p>
                <p>{e.descricao}</p>
              </div>
            ))}
          </div>
        </section>

        {destaques.length > 0 && (
          <section>
            <h2>Destaques</h2>
            <ul class="pontos">{destaques.map((d) => <li>{d.texto} ({d.ano})</li>)}</ul>
          </section>
        )}

        <section class="projetos">
          <h2>Projetos</h2>
          <div class="linha-do-tempo">
            {principais.map(({ data: d }) => (
              <div class="item">
                <div class="linha">
                  <h3>{d.titulo}</h3>
                  {d.repositorio && <a class="quando" href={d.repositorio}>{semProtocolo(d.repositorio)}</a>}
                </div>
                {d.contexto && <p class="lugar">{d.contexto}</p>}
                <p>{d.frase}</p>
                {d.destaques.length > 0 && <ul class="pontos">{d.destaques.map((t) => <li>{t}</li>)}</ul>}
                {d.stack.length > 0 && <ul class="chips claro">{d.stack.map((t) => <li>{t}</li>)}</ul>}
              </div>
            ))}
          </div>
          {outros.length > 0 && (
            <ul class="outros">
              {outros.map(({ data: d }) => (
                <li>
                  <strong>{d.titulo}</strong>{d.contexto && <span class="ctx"> · {d.contexto}</span>}. {d.frase}{' '}
                  {d.stack.length > 0 && <span class="stack">{d.stack.join(' · ')}</span>}
                </li>
              ))}
            </ul>
          )}
        </section>
      </div>
    </article>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 0;
  }
  :root {
    --ink: #12141a;
    --muted: #444a57;
    --subtle: #7a808c;
    --line: #dde0e6;
    --accent: #2446d8;
    --lateral: #141a2e;
    --lateral-texto: #d6dbea;
    --display: 'Newsreader Variable', Georgia, serif;
    --sans: 'Geist Variable', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --w-lateral: 70mm;
    color-scheme: light;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: #e9ebef;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 9pt;
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  h1, h2, h3, p, ul, dl, dd {
    margin: 0;
  }
  ul {
    padding: 0;
    list-style: none;
  }
  a {
    color: inherit;
    text-decoration: none;
  }

  .barra {
    position: sticky;
    top: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 210mm;
    margin: 0 auto;
    padding: 14px 4px;
    font-size: 14px;
  }
  .barra a {
    color: var(--muted);
  }
  .barra button {
    height: 38px;
    padding: 0 18px;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }

  .folha {
    display: grid;
    grid-template-columns: var(--w-lateral) 1fr;
    width: 210mm;
    min-height: 297mm;
    margin: 0 auto 40px;
    background: linear-gradient(to right, var(--lateral) var(--w-lateral), #fff var(--w-lateral));
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.08), 0 12px 40px rgb(0 0 0 / 0.08);
  }

  /* Barra lateral */
  .lateral {
    padding: 12mm 7mm;
    color: var(--lateral-texto);
  }
  .foto {
    width: 34mm;
    height: 34mm;
    margin: 0 auto 7mm;
    overflow: hidden;
    border-radius: 50%;
    border: 1.2mm solid rgb(255 255 255 / 0.14);
    background: #232c4a;
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-size: 24pt;
    color: #fff;
  }
  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lateral section {
    margin-top: 6mm;
  }
  .lateral h2 {
    margin-bottom: 2.5mm;
    padding-bottom: 1.5mm;
    border-bottom: 1px solid rgb(255 255 255 / 0.18);
    color: #fff;
    font-size: 7.6pt;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .lateral h3 {
    color: #fff;
    font-size: 8.6pt;
    font-weight: 600;
  }
  .lateral .contatos {
    display: grid;
    gap: 1.4mm;
    font-size: 8.4pt;
    overflow-wrap: anywhere;
  }
  .lateral .grupo + .grupo {
    margin-top: 3mm;
  }
  .lateral .grupo p {
    margin-top: 0.4mm;
    color: #a6aec6;
    font-size: 8.2pt;
  }
  .lateral .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 1mm;
    margin-top: 1.4mm;
  }
  .lateral .chips li {
    padding: 0.5mm 2mm;
    border-radius: 99px;
    background: rgb(255 255 255 / 0.1);
    color: #e8ebf5;
    font-size: 7.6pt;
  }
  .idiomas {
    display: grid;
    gap: 1.2mm;
    font-size: 8.4pt;
  }
  .idiomas > div {
    display: flex;
    justify-content: space-between;
    gap: 3mm;
  }
  .idiomas dt {
    color: #fff;
    font-weight: 500;
  }
  .idiomas dd {
    color: #a6aec6;
  }

  /* Coluna principal */
  .principal {
    padding: 12mm 11mm 10mm 10mm;
  }
  header {
    padding-bottom: 5mm;
    border-bottom: 1.5px solid var(--ink);
  }
  h1 {
    font-family: var(--display);
    font-size: 30pt;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .cargo {
    margin-top: 2.5mm;
    color: var(--accent);
    font-family: var(--display);
    font-style: italic;
    font-size: 13pt;
  }
  .principal section {
    margin-top: 5.5mm;
  }
  .principal h2 {
    break-after: avoid;
    display: flex;
    align-items: center;
    gap: 3mm;
    margin-bottom: 3mm;
    color: var(--accent);
    font-size: 7.8pt;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .principal h2::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  .resumo {
    color: var(--muted);
  }

  .linha-do-tempo {
    display: grid;
    gap: 4mm;
    padding-left: 4.5mm;
    border-left: 1px solid var(--line);
  }
  .item {
    position: relative;
    break-inside: avoid;
  }
  .item::before {
    content: '';
    position: absolute;
    left: calc(-4.5mm - 1.5mm - 0.5px);
    top: 1.5mm;
    width: 2.6mm;
    height: 2.6mm;
    border-radius: 50%;
    background: #fff;
    border: 1.5px solid var(--accent);
  }
  .linha {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 4mm;
  }
  h3 {
    font-size: 10.2pt;
    font-weight: 600;
    letter-spacing: -0.005em;
  }
  .quando {
    flex-shrink: 0;
    color: var(--subtle);
    font-size: 8.2pt;
  }
  .lugar {
    margin-bottom: 1mm;
    color: var(--accent);
    font-size: 8.6pt;
    font-weight: 500;
  }
  .lugar span {
    color: var(--subtle);
    font-weight: 400;
  }
  .item > p:not(.quando):not(.lugar) {
    color: var(--muted);
  }
  .pontos {
    margin-top: 1.2mm;
    display: grid;
    gap: 0.6mm;
  }
  .pontos li {
    position: relative;
    padding-left: 3.5mm;
    color: var(--muted);
  }
  .pontos li::before {
    content: '';
    position: absolute;
    left: 0.4mm;
    top: 0.62em;
    width: 1.3mm;
    height: 1px;
    background: var(--accent);
  }
  .chips.claro {
    display: flex;
    flex-wrap: wrap;
    gap: 1mm;
    margin-top: 1.8mm;
  }
  .chips.claro li {
    padding: 0.4mm 2mm;
    border-radius: 99px;
    background: #eef1fb;
    color: var(--accent);
    font-size: 7.6pt;
    font-weight: 500;
  }
  .outros {
    display: grid;
    gap: 1.6mm;
    margin-top: 4mm;
    padding-top: 3mm;
    border-top: 1px solid var(--line);
    color: var(--muted);
    break-inside: avoid;
  }
  .outros strong {
    color: var(--ink);
    font-weight: 600;
  }
  .outros .ctx,
  .outros .stack {
    color: var(--subtle);
  }

  @media screen and (max-width: 820px) {
    .folha {
      width: auto;
      min-height: 0;
      margin: 0 12px 24px;
      grid-template-columns: 1fr;
      background: #fff;
    }
    .lateral {
      background: var(--lateral);
      order: 2;
    }
    .principal {
      padding: 24px 20px;
    }
    .barra {
      padding: 12px 16px;
    }
  }

  @media print {
    /* O fundo do canvas se repete em todas as páginas, então a faixa lateral acompanha o texto. */
    html {
      background: linear-gradient(to right, var(--lateral) var(--w-lateral), #fff var(--w-lateral));
    }
    body {
      background: none;
    }
    .barra {
      display: none;
    }
    .folha {
      min-height: 0;
      margin: 0;
      background: none;
      box-shadow: none;
    }
    .principal .projetos {
      break-before: page;
      margin-top: 0;
      padding-top: 12mm;
    }
  }
</style>
