---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../scripts/url';

export async function getStaticPaths() {
  const projetos = await getCollection('projetos');
  return projetos.map((projeto) => ({ params: { slug: projeto.id }, props: { projeto } }));
}

interface Props {
  projeto: CollectionEntry<'projetos'>;
}
const { projeto } = Astro.props;
const { titulo, resumo, stack, tags, repositorio, demo, data, status } = projeto.data;
const { Content } = await render(projeto);
const dataFmt = new Intl.DateTimeFormat('pt-BR', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(data);
const statusFmt = { concluido: 'Concluído', 'em-andamento': 'Em andamento', arquivado: 'Arquivado' }[status];
---

<Base titulo={`${titulo} · Matheus Lencione`} descricao={resumo}>
  <article class="container projeto">
    <a href={url('/#projetos')} class="voltar mono reveal">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg>
      Todos os projetos
    </a>

    <header class="reveal" style="--delay: 60ms">
      <p class="mono meta">{dataFmt} · {statusFmt}</p>
      <h1>{titulo}</h1>
      <p class="resumo">{resumo}</p>
      <div class="acoes">
        {repositorio && <a class="btn primary" href={repositorio} target="_blank" rel="noopener">Ver código</a>}
        {demo && <a class="btn" href={demo} target="_blank" rel="noopener">Ver online</a>}
      </div>
    </header>

    <div class="corpo">
      <div class="prosa reveal" style="--delay: 120ms">
        <Content />
      </div>
      <aside class="ficha reveal" style="--delay: 160ms">
        <div>
          <h2 class="mono">Stack</h2>
          <ul>{stack.map((s) => <li class="tag">{s}</li>)}</ul>
        </div>
        <div>
          <h2 class="mono">Temas</h2>
          <ul>{tags.map((t) => <li class="tag">{t}</li>)}</ul>
        </div>
      </aside>
    </div>
  </article>
</Base>

<style>
  .projeto {
    padding-top: 48px;
    padding-bottom: 112px;
  }
  .voltar {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--fg-muted);
    transition: color 0.2s, gap 0.3s var(--ease);
  }
  .voltar:hover {
    color: var(--fg);
    gap: 12px;
  }
  .voltar svg {
    width: 16px;
    height: 16px;
  }
  header {
    padding: 56px 0 48px;
    border-bottom: 1px solid var(--line);
  }
  .meta {
    color: var(--accent);
    margin-bottom: 16px;
  }
  h1 {
    font-size: clamp(2.25rem, 1.6rem + 3vw, 3.75rem);
    letter-spacing: -0.04em;
  }
  .resumo {
    max-width: 60ch;
    margin-top: 20px;
    color: var(--fg-muted);
    font-size: 1.125rem;
  }
  .acoes {
    display: flex;
    gap: 12px;
    margin-top: 32px;
  }
  .corpo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 64px;
    padding-top: 48px;
  }
  .ficha {
    display: grid;
    align-content: start;
    gap: 28px;
    position: sticky;
    top: 96px;
  }
  .ficha h2 {
    margin-bottom: 12px;
    color: var(--fg-subtle);
    font-weight: 500;
    text-transform: uppercase;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
  }
  .ficha ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .prosa {
    max-width: 68ch;
    color: var(--fg-muted);
    font-size: 1.0625rem;
  }
  .prosa :global(h2) {
    margin: 40px 0 14px;
    color: var(--fg);
    font-size: 1.375rem;
  }
  .prosa :global(h2:first-child) {
    margin-top: 0;
  }
  .prosa :global(p),
  .prosa :global(ul),
  .prosa :global(ol),
  .prosa :global(blockquote) {
    margin: 0 0 16px;
  }
  .prosa :global(ul) {
    list-style: none;
    display: grid;
    gap: 8px;
  }
  .prosa :global(ul li) {
    position: relative;
    padding-left: 20px;
  }
  .prosa :global(ul li)::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
  .prosa :global(ol) {
    padding-left: 22px;
    display: grid;
    gap: 10px;
  }
  .prosa :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }
  .prosa :global(a) {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }
  .prosa :global(code) {
    padding: 2px 6px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg-elev);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.85em;
  }
  .prosa :global(blockquote) {
    padding: 14px 18px;
    border-left: 2px solid var(--accent);
    background: var(--accent-soft);
    border-radius: 0 10px 10px 0;
    font-size: 0.9375rem;
  }
  .prosa :global(blockquote p) {
    margin: 0;
  }
  .prosa :global(img) {
    border-radius: var(--radius);
    border: 1px solid var(--line);
    margin: 24px 0;
  }
  @media (max-width: 820px) {
    .corpo {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .ficha {
      position: static;
      order: -1;
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .projeto {
      padding-top: 32px;
    }
    header {
      padding: 40px 0 36px;
    }
  }
</style>
