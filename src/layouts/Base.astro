---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { perfil } from '../data/perfil';
import { url } from '../scripts/url';

interface Props {
  titulo?: string;
  descricao?: string;
}

const {
  titulo = `${perfil.nome} · Desenvolvedor Full Stack`,
  descricao = perfil.apresentacao.split('. ').slice(0, 2).join('. ') + '.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="text/markdown" href={url('/cv.md')} title="Currículo em Markdown" />
    <meta name="theme-color" content="#0d0f13" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f3f4f6" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <script is:inline>
      (function () {
        var r = document.documentElement;
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) r.classList.add('js');
        try {
          var t = localStorage.getItem('tema');
          if (t === 'light' || t === 'dark') r.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />

    <script>
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -6% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('visible'));
      }
    </script>
  </body>
</html>
